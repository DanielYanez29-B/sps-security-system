<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sps.security.controller.HeaderController"
      styleClass="header" alignment="CENTER_LEFT" prefHeight="70">
    <padding>
        <Insets top="15" right="25" bottom="15" left="25"/>
    </padding>

    <!-- Título y Subtítulo de bienvenida -->
    <VBox HBox.hgrow="ALWAYS" spacing="2">
        <Label fx:id="lblGreeting" styleClass="header-title"/>
        <Label text="Aquí tienes un resumen del estado actual de tus servicios." styleClass="header-subtitle"/>
    </VBox>

    <!-- Panel derecho: Estado, Notificaciones y Configuración -->
    <HBox alignment="CENTER_RIGHT" spacing="15">
        <!-- Indicador Online y Hora -->
        <HBox alignment="CENTER" spacing="8" styleClass="status-badge">
            <Region styleClass="status-dot-online"/>
            <Label fx:id="lblStatusTime"  styleClass="status-text"/>
        </HBox>

        <!-- Botón de Notificaciones con Insignia (Badge) -->
        <StackPane styleClass="notification-container">
            <Button fx:id="btnNotifications" text="🔔" styleClass="icon-button"/>
            <Label fx:id="lblNotificationCount" text="3" styleClass="notification-badge"
                   StackPane.alignment="TOP_RIGHT"/>
        </StackPane>

        <!-- Botón de Cambiar Tema -->
        <Button fx:id="btnThemeToggle" text="⚙" styleClass="icon-button"/>
    </HBox>
</HBox>