<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sps.security.controller.HeaderController"
      styleClass="app-header" alignment="CENTER_LEFT" prefHeight="74" spacing="15">
    <padding>
        <Insets top="15" right="25" bottom="15" left="25"/>
    </padding>

    <!-- Barra de acento y Título / Subtítulo de bienvenida -->
    <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
        <Region styleClass="header-accent-bar" prefWidth="4" prefHeight="38"/>
        <VBox spacing="2">
            <Label fx:id="lblGreeting" text="Bienvenida" styleClass="header-title"/>
            <Label fx:id="lblSubtitle" text="Aquí tienes un resumen del estado actual de tus servicios." styleClass="header-subtitle"/>
        </VBox>
    </HBox>

    <!-- Panel derecho: Estado, Notificaciones y Cambio de Tema -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <!-- Indicador Online y Hora -->
        <HBox alignment="CENTER" spacing="8" styleClass="status-badge">
            <Region styleClass="status-dot-online"/>
            <Label fx:id="lblStatusTime" text="En línea" styleClass="status-text"/>
        </HBox>

        <!-- Botón de Notificaciones con Insignia (Badge) -->
        <StackPane styleClass="notification-container">
            <Button fx:id="btnNotifications" text="🔔" onAction="#onNotifications" styleClass="icon-button"/>
            <Label fx:id="lblNotificationCount" text="0" styleClass="notification-badge"
                   StackPane.alignment="TOP_RIGHT"/>
        </StackPane>

        <!-- Botón de Cambiar Tema -->
        <ToggleButton fx:id="btnTema"
                      text="🌙 Oscuro"
                      onAction="#onToggleTema"
                      styleClass="theme-toggle-btn"/>
    </HBox>
</HBox>