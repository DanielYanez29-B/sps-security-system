<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sps.security.controller.MainController"
            prefWidth="1280" prefHeight="800" styleClass="main-container">

    <!-- Barra lateral de navegación a altura completa -->
    <left>
        <fx:include fx:id="sidebar" source="SidebarView.fxml"/>
    </left>

    <!-- Contenedor derecho: Header arriba + Área dinámica abajo -->
    <center>
        <BorderPane styleClass="right-shell">
            <top>
                <fx:include fx:id="header" source="HeaderView.fxml"/>
            </top>
            <center>
                <StackPane fx:id="contentArea" styleClass="content-area">
                    <!-- Las vistas se cargan dinámicamente aquí -->
                </StackPane>
            </center>
        </BorderPane>
    </center>

</BorderPane>