<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sps.security.controller.GestionAlarmasController" spacing="10" styleClass="operativo-content">
 <Label text="Historial de alarmas" styleClass="operativo-title"/>
 <HBox spacing="8"><DatePicker fx:id="filtroDesde" promptText="Desde"/><DatePicker fx:id="filtroHasta" promptText="Hasta"/><ComboBox fx:id="filtroPrioridad" promptText="Prioridad"/><ComboBox fx:id="filtroEstado" promptText="Estado"/><Button text="Filtrar" onAction="#filtrar"/><Button text="Limpiar" onAction="#limpiarFiltros"/></HBox>
 <HBox spacing="8"><Button text="Marcar atendida" onAction="#marcarAtendida"/><Button text="Marcar falsa alarma" onAction="#marcarFalsa"/></HBox>
 <TableView fx:id="tablaAlarmas" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="columnaId" text="ID"/><TableColumn fx:id="columnaDispositivo" text="Dispositivo"/><TableColumn fx:id="columnaFecha" text="Fecha"/><TableColumn fx:id="columnaTipo" text="Tipo"/><TableColumn fx:id="columnaPrioridad" text="Prioridad"/><TableColumn fx:id="columnaEstado" text="Estado"/></columns></TableView>
</VBox>
