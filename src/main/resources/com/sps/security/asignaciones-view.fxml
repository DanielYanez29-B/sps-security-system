<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sps.security.controller.GestionAsignacionesController"
            stylesheets="@operativo.css"
            styleClass="operativo-root"
            fitToWidth="true"
            hbarPolicy="NEVER">

    <VBox spacing="22" styleClass="operativo-content">

        <VBox spacing="6">

            <Label text="Gestión de Asignaciones"
                   styleClass="operativo-title"/>

            <Label text="Organiza el personal de seguridad por servicio, jornada y fecha."
                   styleClass="operativo-subtitle"/>

        </VBox>

        <VBox spacing="18" styleClass="operativo-card">

            <Label text="Datos de la asignación"
                   styleClass="operativo-card-title"/>

            <Label text="Selecciona un guardia, un servicio y una jornada activos."
                   styleClass="operativo-subtitle"/>

            <GridPane hgap="16" vgap="14">

                <columnConstraints>
                    <ColumnConstraints minWidth="155"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Fila 0: Guardia / Usuarios -->
                <Label text="Guardia"
                       styleClass="operativo-label"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <HBox spacing="8"
                      GridPane.rowIndex="0"
                      GridPane.columnIndex="1">
                    <ComboBox fx:id="campoIdGuardia"
                              promptText="Selecciona un guardia"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS"
                              styleClass="operativo-input"/>
                    <Button text="Administrar usuarios..."
                            onAction="#abrirGestionUsuarios"
                            styleClass="operativo-button,operativo-secondary"/>
                </HBox>

                <!-- Fila 1: Servicio (sin cambios) -->
                <Label text="Servicio"
                       styleClass="operativo-label"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="campoIdServicio"
                          promptText="Selecciona un servicio"
                          maxWidth="Infinity"
                          styleClass="operativo-input"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"/>

                <!-- Fila 2: Jornada -->
                <Label text="Jornada"
                       styleClass="operativo-label"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <HBox spacing="8"
                      GridPane.rowIndex="2"
                      GridPane.columnIndex="1">
                    <ComboBox fx:id="campoIdJornada"
                              promptText="Selecciona una jornada"
                              maxWidth="Infinity"
                              HBox.hgrow="ALWAYS"
                              styleClass="operativo-input"/>
                    <Button text="Administrar jornadas..."
                            onAction="#abrirGestionJornadas"
                            styleClass="operativo-button,operativo-secondary"/>
                </HBox>
                <Label text="Fecha de asignación"
                       styleClass="operativo-label"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <DatePicker fx:id="campoFechaAsignacion"
                            maxWidth="Infinity"
                            styleClass="operativo-input"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="1"/>

            </GridPane>

            <HBox spacing="10">

                <Button fx:id="botonGuardar"
                        text="Registrar asignación"
                        onAction="#guardarAsignacion"
                        styleClass="operativo-button,operativo-primary"/>

                <Button text="Nuevo / Limpiar"
                        onAction="#nuevaAsignacion"
                        styleClass="operativo-button,operativo-secondary"/>

                <Button text="Eliminar asignación"
                        onAction="#eliminarAsignacion"
                        styleClass="operativo-button,operativo-danger"/>

            </HBox>

        </VBox>

        <VBox spacing="16" styleClass="operativo-card">

            <HBox spacing="15" alignment="CENTER_LEFT">

                <Label text="Asignaciones registradas"
                       styleClass="operativo-card-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Actualizar tabla"
                        onAction="#actualizarTabla"
                        styleClass="operativo-button,operativo-secondary"/>

            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">

                <Label text="Filtrar por fecha"
                       styleClass="operativo-label"/>

                <DatePicker fx:id="filtroFecha"
                            promptText="Todas las fechas"
                            styleClass="operativo-input"/>

                <Button text="Limpiar filtro"
                        onAction="#limpiarFiltro"
                        styleClass="operativo-button,operativo-secondary"/>

            </HBox>

            <TableView fx:id="tablaAsignaciones"
                       prefHeight="350"
                       styleClass="operativo-table"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="columnaId"
                                 text="ID"
                                 prefWidth="75"/>

                    <TableColumn fx:id="columnaGuardia"
                                 text="ID Guardia"
                                 prefWidth="145"/>

                    <TableColumn fx:id="columnaServicio"
                                 text="ID Servicio"
                                 prefWidth="145"/>

                    <TableColumn fx:id="columnaJornada"
                                 text="ID Jornada"
                                 prefWidth="145"/>

                    <TableColumn fx:id="columnaFecha"
                                 text="Fecha de asignación"
                                 prefWidth="190"/>

                </columns>

            </TableView>

        </VBox>

    </VBox>

</ScrollPane>
