<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sps.security.controller.GestionElementosSupervisadosController"
           styleClass="view-root">
    <VBox spacing="18" styleClass="operativo-content">
        <VBox spacing="4">
            <Label text="Gestión de Elementos Supervisados" styleClass="operativo-title"/>
            <Label text="Gestiona los elementos supervisados asignados a cada servicio." styleClass="operativo-subtitle"/>
        </VBox>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <TextField fx:id="campoFiltroServicio" promptText="Filtrar por ID de servicio" prefWidth="180" styleClass="operativo-input"/>
            <Button text="Buscar" onAction="#filtrarPorServicio" styleClass="operativo-button,operativo-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#abrirFormularioNuevo" text="+ Nuevo elemento" styleClass="operativo-button,operativo-primary"/>
        </HBox>
        <VBox styleClass="operativo-card" VBox.vgrow="ALWAYS">
            <TableView fx:id="tablaElementos" styleClass="operativo-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="columnaId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="columnaIdServicio" text="ID Servicio" prefWidth="90"/>
                    <TableColumn fx:id="columnaTipo" text="Tipo" prefWidth="120"/>
                    <TableColumn fx:id="columnaIdentificador" text="Identificador" prefWidth="170"/>
                    <TableColumn fx:id="columnaDescripcion" text="Descripción" prefWidth="230"/>
                    <TableColumn fx:id="columnaEstado" text="Estado" prefWidth="100"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

    <StackPane fx:id="modalFormulario" managed="false" visible="false" styleClass="modal-backdrop">
        <VBox maxWidth="440" spacing="12" styleClass="modal-card">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="lblModalTitulo" text="Nuevo Elemento" styleClass="operativo-card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#ocultarFormulario" text="✕" styleClass="btn-close-modal"/>
            </HBox>
            <Separator/>
            <VBox spacing="6"><Label text="ID de servicio" styleClass="operativo-label"/><TextField fx:id="campoIdServicio" styleClass="operativo-input"/></VBox>
            <VBox spacing="6"><Label text="Tipo de elemento" styleClass="operativo-label"/><ComboBox fx:id="comboTipoElemento" maxWidth="Infinity" styleClass="operativo-input"/></VBox>
            <VBox spacing="6"><Label text="Identificador" styleClass="operativo-label"/><TextField fx:id="campoIdentificador" styleClass="operativo-input"/></VBox>
            <VBox spacing="6"><Label text="Descripción" styleClass="operativo-label"/><TextField fx:id="campoDescripcion" styleClass="operativo-input"/></VBox>
            <VBox spacing="6"><Label text="Estado" styleClass="operativo-label"/><ComboBox fx:id="comboEstado" maxWidth="Infinity" styleClass="operativo-input"/></VBox>
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <VBox.margin><Insets top="10"/></VBox.margin>
                <Button onAction="#nuevoElemento" text="Limpiar" styleClass="operativo-button,operativo-secondary"/>
                <Button onAction="#desactivarElemento" text="Desactivar" styleClass="operativo-button,operativo-danger"/>
                <Button onAction="#eliminarElemento" text="Eliminar" styleClass="operativo-button,operativo-danger"/>
                <Button fx:id="botonGuardar" onAction="#guardarElemento" text="Guardar" styleClass="operativo-button,operativo-primary"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
