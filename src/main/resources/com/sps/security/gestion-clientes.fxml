<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<SplitPane dividerPositions="0.43"
           prefHeight="600.0"
           prefWidth="1000.0"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sps.security.controller.GestionClientesController">

    <items>

        <!-- Panel izquierdo: Formulario -->
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
            </padding>

            <children>
                <Label text="Gestión de Clientes"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                <GridPane hgap="8.0" vgap="8.0">
                    <children>

                        <Label text="Nombre o razón social:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtNombre" promptText="Nombre del cliente" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="RFC:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtRfc" promptText="RFC" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Teléfono:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtTelefono" promptText="Teléfono" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtEmail" promptText="correo@ejemplo.com" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Calle:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtCalle" promptText="Calle" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Número exterior:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtNumExt" promptText="Número exterior" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Colonia:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtColonia" promptText="Colonia" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                        <Label text="Ciudad:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtCiudad" promptText="Ciudad" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                        <Label text="Estado:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtEstado" promptText="Estado" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                        <Label text="Código postal:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtCp" promptText="Código postal" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                    </children>
                </GridPane>

                <HBox alignment="CENTER" spacing="7.0">
                    <children>
                        <Button onAction="#handleGuardar"
                                text="Guardar"
                                style="-fx-background-color: #2e7d32; -fx-text-fill: white;"/>

                        <Button onAction="#handleActualizar"
                                text="Actualizar"
                                style="-fx-background-color: #1565c0; -fx-text-fill: white;"/>

                        <Button onAction="#handleEliminar"
                                text="Eliminar"
                                style="-fx-background-color: #c62828; -fx-text-fill: white;"/>

                        <Button onAction="#handleLimpiar" text="Limpiar"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Panel derecho: Tabla de clientes -->
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
            </padding>

            <children>
                <Label text="Lista de Clientes"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="45.0" text="ID"/>
                        <TableColumn fx:id="colNombre" prefWidth="130.0" text="Nombre"/>
                        <TableColumn fx:id="colRfc" prefWidth="100.0" text="RFC"/>
                        <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono"/>
                        <TableColumn fx:id="colEmail" prefWidth="150.0" text="Email"/>
                        <TableColumn fx:id="colCiudad" prefWidth="100.0" text="Ciudad"/>
                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

    </items>
</SplitPane>
