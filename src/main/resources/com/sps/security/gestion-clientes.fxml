<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.43"
           prefHeight="600.0"
           prefWidth="1000.0"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sps.security.controller.GestionClientesController">

    <items>

        <!-- Panel izquierdo: Formulario -->
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER">

            <content>
                <VBox spacing="12.0">

                    <padding>
                        <Insets top="15.0"
                                right="15.0"
                                bottom="15.0"
                                left="15.0"/>
                    </padding>

                    <children>

                        <Label text="Gestión de Clientes"
                               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                        <GridPane hgap="8.0" vgap="10.0">

                            <columnConstraints>
                                <ColumnConstraints minWidth="125.0"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <children>

                                <Label text="Nombre o razón social:"
                                       GridPane.rowIndex="0"/>
                                <TextField fx:id="txtNombre"
                                           promptText="Nombre del cliente"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="0"/>

                                <Label text="RFC:"
                                       GridPane.rowIndex="1"/>
                                <TextField fx:id="txtRfc"
                                           promptText="RFC"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="1"/>

                                <Label text="Teléfono:"
                                       GridPane.rowIndex="2"/>
                                <TextField fx:id="txtTelefono"
                                           promptText="Teléfono"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="2"/>

                                <Label text="Email:"
                                       GridPane.rowIndex="3"/>
                                <TextField fx:id="txtEmail"
                                           promptText="correo@ejemplo.com"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="3"/>

                                <Label text="Calle:"
                                       GridPane.rowIndex="4"/>
                                <TextField fx:id="txtCalle"
                                           promptText="Calle"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="4"/>

                                <Label text="Número exterior:"
                                       GridPane.rowIndex="5"/>
                                <TextField fx:id="txtNumExt"
                                           promptText="Número exterior"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="5"/>

                                <Label text="Colonia:"
                                       GridPane.rowIndex="6"/>
                                <TextField fx:id="txtColonia"
                                           promptText="Colonia"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="6"/>

                                <Label text="Ciudad:"
                                       GridPane.rowIndex="7"/>
                                <TextField fx:id="txtCiudad"
                                           promptText="Ciudad"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="7"/>

                                <Label text="Estado:"
                                       GridPane.rowIndex="8"/>
                                <TextField fx:id="txtEstado"
                                           promptText="Estado"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="8"/>

                                <Label text="Código postal:"
                                       GridPane.rowIndex="9"/>
                                <TextField fx:id="txtCp"
                                           promptText="Código postal"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="9"/>

                            </children>
                        </GridPane>

                        <HBox alignment="CENTER"
                              spacing="7.0">

                            <children>

                                <Button text="Guardar"
                                        onAction="#handleGuardar"
                                        style="-fx-background-color: #2e7d32; -fx-text-fill: white;"/>

                                <Button text="Actualizar"
                                        onAction="#handleActualizar"
                                        style="-fx-background-color: #1565c0; -fx-text-fill: white;"/>

                                <Button text="Eliminar"
                                        onAction="#handleEliminar"
                                        style="-fx-background-color: #c62828; -fx-text-fill: white;"/>

                                <Button text="Limpiar"
                                        onAction="#handleLimpiar"/>

                            </children>
                        </HBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <!-- Panel derecho: Tabla -->
        <VBox spacing="10.0">

            <padding>
                <Insets top="15.0"
                        right="15.0"
                        bottom="15.0"
                        left="15.0"/>
            </padding>

            <children>

                <Label text="Lista de Clientes"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <TableView fx:id="tblClientes"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="45.0"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="130.0"/>

                        <TableColumn fx:id="colRfc"
                                     text="RFC"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="colTelefono"
                                     text="Teléfono"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="colEmail"
                                     text="Email"
                                     prefWidth="150.0"/>

                        <TableColumn fx:id="colCiudad"
                                     text="Ciudad"
                                     prefWidth="100.0"/>

                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                </TableView>

            </children>
        </VBox>

    </items>
</SplitPane>
