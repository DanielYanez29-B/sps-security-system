<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sps.security.controller.GestionGuardiasController"
           styleClass="view-root">
    <VBox spacing="18" styleClass="operativo-content">
        <VBox spacing="4">
            <Label text="Gestión de Guardias" styleClass="operativo-title"/>
            <Label text="Gestiona y consulta el estado de tu personal operativo." styleClass="operativo-subtitle"/>
        </VBox>
        <HBox alignment="CENTER_LEFT">
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#abrirFormularioNuevo" text="+ Nuevo guardia" styleClass="operativo-button,operativo-primary"/>
        </HBox>
        <VBox styleClass="operativo-card" VBox.vgrow="ALWAYS">
            <TableView fx:id="tablaGuardias" styleClass="operativo-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="columnaId" text="ID" prefWidth="65"/>
                    <TableColumn fx:id="columnaNombre" text="Nombre completo" prefWidth="230"/>
                    <TableColumn fx:id="columnaRfc" text="RFC" prefWidth="165"/>
                    <TableColumn fx:id="columnaFecha" text="Fecha de ingreso" prefWidth="155"/>
                    <TableColumn fx:id="columnaEstado" text="Estado" prefWidth="110"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

    <StackPane fx:id="modalFormulario" managed="false" visible="false" styleClass="modal-backdrop">
        <VBox maxWidth="440" spacing="12" styleClass="modal-card">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="lblModalTitulo" text="Nuevo Guardia" styleClass="operativo-card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#ocultarFormulario" text="✕" styleClass="btn-close-modal"/>
            </HBox>
            <Separator/>
            <VBox spacing="6"><Label text="ID de usuario" styleClass="operativo-label"/><TextField fx:id="campoIdUsuario" promptText="Opcional" styleClass="operativo-input"/></VBox>
            <VBox spacing="6"><Label text="Nombres" styleClass="operativo-label"/><TextField fx:id="campoNombres" styleClass="operativo-input"/></VBox>
            <VBox spacing="6"><Label text="Apellido paterno" styleClass="operativo-label"/><TextField fx:id="campoApellidoPaterno" styleClass="operativo-input"/></VBox>
            <VBox spacing="6"><Label text="Apellido materno" styleClass="operativo-label"/><TextField fx:id="campoApellidoMaterno" promptText="Opcional" styleClass="operativo-input"/></VBox>
            <VBox spacing="6"><Label text="RFC" styleClass="operativo-label"/><TextField fx:id="campoRfc" styleClass="operativo-input"/></VBox>
            <VBox spacing="6"><Label text="Fecha de ingreso" styleClass="operativo-label"/><DatePicker fx:id="campoFechaIngreso" maxWidth="Infinity" styleClass="operativo-input"/></VBox>
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <VBox.margin><Insets top="10"/></VBox.margin>
                <Button onAction="#nuevoGuardia" text="Limpiar" styleClass="operativo-button,operativo-secondary"/>
                <Button onAction="#desactivarGuardia" text="Desactivar" styleClass="operativo-button,operativo-danger"/>
                <Button onAction="#activarGuardia" text="Activar" styleClass="operativo-button,operativo-success"/>
                <Button fx:id="botonGuardar" onAction="#guardarGuardia" text="Guardar" styleClass="operativo-button,operativo-primary"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
