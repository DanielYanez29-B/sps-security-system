<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sps.security.controller.GestionJornadasController"
           styleClass="view-root">
    <VBox spacing="18.0" styleClass="operativo-content">
        <VBox spacing="4.0">
            <Label text="Gestión de Jornadas" styleClass="operativo-title"/>
            <Label text="Consulta y administra los turnos del personal." styleClass="operativo-subtitle"/>
        </VBox>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#abrirFormularioNuevo" text="+ Nueva jornada" styleClass="operativo-button,operativo-primary"/>
        </HBox>
        <VBox styleClass="operativo-card" VBox.vgrow="ALWAYS">
            <TableView fx:id="tblJornadas" styleClass="operativo-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                    <TableColumn fx:id="colInicio" text="Inicio" prefWidth="100"/>
                    <TableColumn fx:id="colFin" text="Fin" prefWidth="100"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

    <StackPane fx:id="modalFormulario" managed="false" visible="false" styleClass="modal-backdrop">
        <VBox maxWidth="440" spacing="12" styleClass="modal-card">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="lblModalTitulo" text="Nueva Jornada" styleClass="operativo-card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#ocultarFormulario" text="✕" styleClass="btn-close-modal"/>
            </HBox>
            <Separator/>
            <VBox spacing="6"><Label text="Nombre de la jornada:" styleClass="operativo-label"/><TextField fx:id="txtNombre" promptText="Ej. Matutino" styleClass="operativo-input"/></VBox>
            <VBox spacing="6"><Label text="Hora de inicio (HH:mm):" styleClass="operativo-label"/><TextField fx:id="txtHoraInicio" promptText="Ej. 06:00" styleClass="operativo-input"/></VBox>
            <VBox spacing="6"><Label text="Hora de fin (HH:mm):" styleClass="operativo-label"/><TextField fx:id="txtHoraFin" promptText="Ej. 14:00" styleClass="operativo-input"/></VBox>
            <Label text="Los turnos nocturnos pueden terminar al día siguiente." wrapText="true" styleClass="operativo-subtitle"/>
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <VBox.margin><Insets top="10"/></VBox.margin>
                <Button onAction="#handleLimpiar" text="Limpiar" styleClass="operativo-button,operativo-secondary"/>
                <Button onAction="#handleDesactivar" text="Desactivar" styleClass="operativo-button,operativo-danger"/>
                <Button onAction="#handleActivar" text="Activar" styleClass="operativo-button,operativo-success"/>
                <Button fx:id="btnActualizar" onAction="#handleActualizar" text="Actualizar" styleClass="operativo-button,operativo-primary"/>
                <Button fx:id="btnGuardar" onAction="#handleGuardar" text="Guardar" styleClass="operativo-button,operativo-primary"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
