<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.sps.security.controller.GestionJornadasController"
        dividerPositions="0.37"
        prefHeight="550.0"
        prefWidth="950.0">

    <items>

        <!-- FORMULARIO -->
        <VBox spacing="12.0">

            <padding>
                <Insets top="20" bottom="20"
                        left="20" right="20"/>
            </padding>

            <children>

                <Label text="Gestión de Jornadas"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;"/>

                <Label text="Nombre de la jornada:"/>

                <TextField fx:id="txtNombre"
                           promptText="Ej. Matutino"/>

                <Label text="Hora de inicio (HH:mm):"/>

                <TextField fx:id="txtHoraInicio"
                           promptText="Ej. 06:00"/>

                <Label text="Hora de fin (HH:mm):"/>

                <TextField fx:id="txtHoraFin"
                           promptText="Ej. 14:00"/>

                <Label
                        text="Los turnos nocturnos pueden terminar al día siguiente."
                        wrapText="true"
                        style="-fx-text-fill: #666666;"/>

                <HBox spacing="8.0">

                    <children>

                        <Button text="Guardar"
                                onAction="#handleGuardar"
                                style="-fx-background-color: #2e7d32;
                                       -fx-text-fill: white;"/>

                        <Button text="Actualizar"
                                onAction="#handleActualizar"
                                style="-fx-background-color: #1565c0;
                                       -fx-text-fill: white;"/>

                    </children>

                </HBox>

                <HBox spacing="8.0">

                    <children>

                        <Button text="Desactivar"
                                onAction="#handleDesactivar"
                                style="-fx-background-color: #c62828;
                                       -fx-text-fill: white;"/>

                        <Button text="Activar"
                                onAction="#handleActivar"
                                style="-fx-background-color: #008577;
                                       -fx-text-fill: white;"/>

                        <Button text="Limpiar"
                                onAction="#handleLimpiar"/>

                    </children>

                </HBox>

            </children>

        </VBox>

        <!-- TABLA DE JORNADAS -->
        <VBox spacing="10.0">

            <padding>
                <Insets top="20" bottom="20"
                        left="15" right="15"/>
            </padding>

            <children>

                <Label text="Jornadas registradas"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;"/>

                <TableView fx:id="tblJornadas"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colId"
                                     text="ID"
                                     prefWidth="45"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="130"/>

                        <TableColumn fx:id="colInicio"
                                     text="Inicio"
                                     prefWidth="75"/>

                        <TableColumn fx:id="colFin"
                                     text="Fin"
                                     prefWidth="75"/>

                        <TableColumn fx:id="colEstado"
                                     text="Estado"
                                     prefWidth="85"/>

                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                </TableView>

            </children>

        </VBox>

    </items>

</SplitPane>
