<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sps.security.controller.NotificacionesController"
      spacing="18" styleClass="view-root,operativo-content">
    <VBox spacing="4">
        <Label text="Notificaciones" styleClass="operativo-title"/>
        <Label text="Revisa los avisos recientes del sistema." styleClass="operativo-subtitle"/>
    </VBox>
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Marcar seleccionada" onAction="#marcarLeida" styleClass="operativo-button,operativo-secondary"/>
        <Button text="Marcar todas como leídas" onAction="#marcarTodas" styleClass="operativo-button,operativo-primary"/>
    </HBox>
    <VBox styleClass="operativo-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tablaNotificaciones" styleClass="operativo-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="columnaFecha" text="Fecha" prefWidth="180"/>
                <TableColumn fx:id="columnaMensaje" text="Mensaje" prefWidth="500"/>
                <TableColumn fx:id="columnaLeida" text="Estado" prefWidth="110"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
