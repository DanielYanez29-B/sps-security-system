<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="650.0" prefWidth="920.0" stylesheets="@gestion_usuarios.css"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sps.security.controller.GestionUsuariosController">

    <!-- CAPA 1: ÁREA DE CONTENIDO -->
    <VBox spacing="20.0" styleClass="main-content">
        <!-- Encabezado Superior -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <VBox spacing="4.0">
                <Label styleClass="page-title" text="Gestión de Usuarios" />
                <Label styleClass="page-subtitle" text="Gestiona y consulta las cuentas y roles del sistema." />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="status-online" text="●  En línea" />
        </HBox>

        <!-- Barra de Filtros y Botón Principal -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <HBox spacing="6.0" styleClass="filter-bar">
                <Button styleClass="filter-pill, filter-pill-active" text="Todos" />
                <Button styleClass="filter-pill" text="Activos" />
                <Button styleClass="filter-pill" text="Inactivos" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#mostrarFormulario" styleClass="btn-primary-purple" text="+  Nuevo usuario" />
        </HBox>

        <!-- Tarjeta Blanca con la Tabla -->
        <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
            <TableView fx:id="tblUsuarios" styleClass="modern-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                    <TableColumn fx:id="colUsername" prefWidth="180.0" text="Username" />
                    <TableColumn fx:id="colEmail" prefWidth="240.0" text="Email" />
                    <TableColumn fx:id="colRol" prefWidth="110.0" text="ID Rol" />
                    <TableColumn fx:id="colEstado" prefWidth="140.0" text="Estado" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

    <!-- CAPA 2: MODAL FLOTANTE PARA EL FORMULARIO -->
    <StackPane fx:id="modalFormulario" managed="false" styleClass="modal-backdrop" visible="false">
        <VBox maxHeight="-Infinity" maxWidth="430.0" spacing="12.0" styleClass="modal-card">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="modal-title" text="Formulario de Usuario" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#ocultarFormulario" styleClass="btn-close-modal" text="✕" />
            </HBox>

            <Label styleClass="form-label" text="Username:" />
            <TextField fx:id="txtUsername" promptText="ej. jdoe" styleClass="modern-input" />

            <Label styleClass="form-label" text="Correo Electrónico (Email):" />
            <TextField fx:id="txtEmail" promptText="ej. usuario@sps.com" styleClass="modern-input" />

            <Label styleClass="form-label" text="Contraseña:" />
            <PasswordField fx:id="txtContrasena" promptText="••••••••" styleClass="modern-input" />

            <Label styleClass="form-label" text="ID Rol:" />
            <TextField fx:id="txtIdRol" promptText="ej. 1" styleClass="modern-input" />

            <CheckBox fx:id="chkEstadoActivo" selected="true" styleClass="modern-checkbox" text="Estado Activo" />

            <HBox alignment="CENTER" spacing="8.0">
                <VBox.margin>
                    <Insets top="12.0" />
                </VBox.margin>
                <Button onAction="#handleGuardar" styleClass="btn-success" text="Guardar" />
                <Button onAction="#handleActualizar" styleClass="btn-info" text="Actualizar" />
                <Button onAction="#handleEliminar" styleClass="btn-danger" text="Eliminar" />
                <Button onAction="#handleLimpiar" styleClass="btn-neutral" text="Limpiar" />
            </HBox>
        </VBox>
    </StackPane>

</StackPane>